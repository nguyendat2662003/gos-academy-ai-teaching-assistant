# Copy to .env and fill in real values. NEVER commit .env.
# All values below are fake placeholders.

# --- App ---
# dev | prod  (/demo is only enabled in dev)
APP_ENV=dev
LOG_LEVEL=INFO

# --- Infrastructure ---
# Inside docker compose the hosts are "postgres" / "redis".
# From the host (pytest, scripts) use the published ports below.
POSTGRES_USER=gos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gos
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
DATABASE_URL=postgresql+asyncpg://gos:change-me@postgres:5432/gos
REDIS_URL=redis://redis:6379/0
# Separate database used by pytest (created automatically by tests/conftest.py).
# Use 127.0.0.1, not localhost: on Windows localhost may resolve to ::1 first while ports are bound on IPv4.
TEST_DATABASE_URL=postgresql+asyncpg://gos:change-me@127.0.0.1:5433/gos_test
TEST_REDIS_URL=redis://127.0.0.1:6380/15

# --- Secrets ---
# Generate long random strings: python -c "import secrets;print(secrets.token_hex(32))"
WEBHOOK_SECRET=change-me-webhook-secret
ADMIN_API_KEY=change-me-admin-key
# One key per class for its instructor (admin page limited to that class; DECISIONS D-83). Leave empty for
# admin-only. Format: CLASS_ID=<key>,CLASS_ID=<key> (each key >= 16 characters, all different).
INSTRUCTOR_API_KEYS=GS-KPI-01=change-me-gs-instructor-key,AUTO-N8N-01=change-me-auto-instructor-key
ASK_API_KEY=change-me-ask-key
USER_HASH_SALT=change-me-user-hash-salt

# --- LLM ---
# gemini | openai | fake. Switch to openai once OPENAI_API_KEY is filled in (fake works fully offline).
LLM_PROVIDER=
# Chosen: OpenAI gpt-6-luna (fallback: gpt-5.6-luna). Verify the id on developers.openai.com.
LLM_MODEL=gpt-6-luna
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Embedding ---
# gemini | openai | fake
EMBEDDING_PROVIDER=
# text-embedding-3-* accept a `dimensions` parameter, so 768 works without changing the DB column.
EMBEDDING_MODEL=text-embedding-3-small
# Must match the DB column (migration 0001). Changing it requires a new migration + full reindex.
# Switching provider/model with the same dim still requires a full reindex (vectors are not comparable).
EMBEDDING_DIM=768

# --- Agent behaviour ---
GUARD_LLM_ENABLED=false
# Comma separated. The first one is shown on /demo; a trigger starting with @ is the bot's mention (D-86)
TRIGGER_PREFIXES=@Trợ lý,/hoi
RATE_LIMIT_USER_PER_MIN=5
RATE_LIMIT_CLASS_PER_MIN=30
RETRIEVAL_TOP_K=5
# Calibrated with scripts/eval_rag.py on data/eval/golden.yaml (DECISIONS D-60, D-74)
RETRIEVAL_MIN_SCORE=0.35
CONTEXT_MAX_TURNS=6
CONTEXT_TTL_MINUTES=30
